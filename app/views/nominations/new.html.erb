<div class="max-w-2xl mx-auto bg-white shadow-lg rounded-lg overflow-hidden">
  <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
    <h1 class="text-2xl font-bold text-gray-900">Add GotM Nomination</h1>
    <p class="mt-1 text-sm text-gray-600">Bypasses the nomination window. All other nomination rules still apply.</p>
  </div>

  <div class="px-6 py-6">
    <%= form_with(model: @nomination, class: "space-y-6") do |form| %>
      <div>
        <%= form.label :theme_id, "Theme", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :theme_id, Theme.gotm.order(creation_date: :desc), :id,
              ->(t) { "#{t.creation_date.strftime('%b %Y')} — #{t.title}" }, {},
              required: true, class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 sm:text-sm rounded-md" %>
      </div>

      <div>
        <%= form.label :user_id, "User", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :user_id, User.order(:name), :id, :name, { prompt: "Select a user" },
              required: true, class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 sm:text-sm rounded-md" %>
      </div>

      <div>
        <%= form.label :screenscraper_id, "ScreenScraper ID", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :screenscraper_id, value: @screenscraper_id, required: true, inputmode: "numeric",
              class: "mt-1 shadow-xs block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :description, rows: 3, class: "mt-1 shadow-xs block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>

      <%= form.submit "Add Nomination", class: "w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-xs text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
    <% end %>
  </div>
</div>
